#!/usr/sbin/nft -f
# Base zone policy for fw, the stand-in data path for the Palo Alto.
# eth1 = zone tenant (VRF tenant), eth2 = zone guest (VRF guest).
# Set names must be <zone>_ifaces: the PAN-OS emulator reads them as zones.
flush ruleset
table inet zones {
    set tenant_ifaces { type ifname; elements = { "eth1" } }
    set guest_ifaces  { type ifname; elements = { "eth2" } }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        # Everything else is the emulator's committed rulebase. sync-fw.py
        # fills this chain; empty means default deny between zones.
        jump zone_policy
    }
    chain zone_policy { }
}
