#!/usr/bin/env bash
# Campus lab entry point.
#
# Lifecycle verbs delegate to the repository driver (../labctl) and to
# labs.toml, which owns the runtime directory preparation, the two local image
# builds and the radio attach/detach hooks. The commands below stay here
# because they are specific to this lab and need no lab-name argument.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd -- "$here/.." && pwd)

usage() {
  printf 'Usage: %s {check|up|verify|verify-identity|wireless|reconcile|publish|whereis|show vlan-vni [NODE|all]|status|down}\n' "$0" >&2
}

show_vlan_vni() {
  # Prints the kernel and zebra view of the VXLAN dataplane. Read-only, and it
  # runs from inside the node, so it needs no image and no tooling on the host.
  local lab=evpn-vxlan-campus
  local want=${1:-leaf1a} node
  local nodes=(leaf1a leaf2a leaf1b leaf2b bdr-a bdr-a2 bdr-b bdr-b2)
  [ "$want" = all ] || nodes=("$want")
  for node in "${nodes[@]}"; do
    docker exec -i "clab-${lab}-${node}" bash -s \
      < "$here/scripts/show-vxlan.sh" \
      || printf '%s: docker exec failed for clab-%s-%s\n' "$0" "$lab" "$node" >&2
    echo
  done
}

case "${1:-}" in
  check|list|doctor)
    exec "$repo/labctl" "$@"
    ;;
  up|down|status|prepare)
    exec "$repo/labctl" "$@" evpn-vxlan-campus
    ;;
  verify)
    # The identity checks are part of this lab's verification.
    exec "$repo/labctl" verify evpn-vxlan-campus
    ;;
  verify-identity)
    exec "$here/verify-identity.sh"
    ;;
  reconcile)
    ( cd "$here/reconcile" && exec python3 reconcile.py "${@:2}" )
    ;;
  publish)
    ( cd "$here/reconcile" && exec python3 publish.py "${@:2}" )
    ;;
  whereis)
    ( cd "$here/reconcile" && exec python3 whereis.py "${@:2}" )
    ;;
  show)
    case "${2:-}" in
      vlan-vni) show_vlan_vni "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  wireless)
    exec "$here/identity/wireless-attach.sh"
    ;;
  *)
    usage
    exit 2
    ;;
esac
